# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Manim / rendered media (never commit videos or audio)
media/
output/
*.mp4
*.mov
*.wav
*.mp3
*.flac
*.ogg

# Voice recordings are personal data: keep them out of git
# (voice.json metadata is still tracked).
assets/voices/**/*.wav

# Generated by scripts/generate_video.py (rebuilt from animation.py)
cache/
lessons/*/generated/
lessons/*/alignment/
lessons/*/subtitles/*.srt
lessons/*/subtitles/*.vtt

# OS / editor / secrets
.DS_Store
Thumbs.db
.vscode/
.env

# Portable tools (e.g. tools/blender/, downloaded by the setup notes in README)
tools/

# Local user data: YouTube OAuth client + token (encrypted), preferences
local/

# Team distribution ZIPs (python scripts/make_package.py)
dist/
